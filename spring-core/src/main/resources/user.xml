<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:context="http://www.springframework.org/schema/context"
	xmlns:tx="http://www.springframework.org/schema/tx"
	xsi:schemaLocation="http://www.springframework.org/schema/beans
  http://www.springframework.org/schema/beans/spring-beans-4.0.xsd
  http://www.springframework.org/schema/context
    http://www.springframework.org/schema/context/spring-context-4.0.xsd
    http://www.springframework.org/schema/tx
    http://www.springframework.org/schema/tx/spring-tx-4.0.xsd">

	<!-- by setter method's -->
	<bean name="user" class="com.rays.test.User">
		<property name="login" value="abc"></property>
		<property name="password" value="xyz"></property>
	</bean>

	<!-- by constructor -->
	<!-- <bean name="user" class="com.rays.test.User">
		<constructor-arg value="abc"></constructor-arg>
		<constructor-arg value="xyz"></constructor-arg>
	</bean> -->
</beans>